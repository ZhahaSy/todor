{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@client/hooks": ["../hooks/src/index.ts"],
      "@client/api": ["../api/index.ts"],
      "@client/utils": ["../utils/src/index.ts"]
    }
  },
  "include": ["src", "index.ts", "*.ts", "*.tsx"]
}
