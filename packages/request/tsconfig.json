{
    "include": ["src"],
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["es2020", "dom"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "allowImportingTsExtensions": true
    },
    "exclude": ["node_modules"]
}
