# 运行环境
NODE_ENV=development

# DeepSeek AI 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT_MS=60000
# 单用户每日 AI 对话次数上限（成本护栏）；0 或留空表示不限制
# 注意：此处仅为默认值。运行时可通过管理员接口 PUT /api/ai/quota 动态修改（存 Redis，改完即时生效，覆盖此默认值）
AI_DAILY_QUOTA=100
# 配额白名单：逗号分隔的用户 id，这些用户不限量、不计入配额（可与 ADMIN_USER_IDS 重叠）
AI_QUOTA_WHITELIST=
# 管理员用户 id（逗号分隔）：可调用 /api/ai/quota 配额管理接口，且自动进入配额白名单
ADMIN_USER_IDS=

# JWT 配置（必填，缺失则服务拒绝启动；请用足够随机的长字符串）
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# 数据库配置
DB_TYPE=sqlite
DB_DATABASE=/var/data/chat-service/chat.db

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 邮件配置
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USER=your_email@qq.com
MAIL_PASS=your_email_authorization_code_here

# 腾讯云 ASR（语音识别）配置
TENCENT_SECRET_ID=your_tencent_secret_id_here
TENCENT_SECRET_KEY=your_tencent_secret_key_here
